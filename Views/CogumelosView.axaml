<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CultivoApp.Converters"
             xmlns:vm="using:CultivoApp.ViewModels"
             xmlns:models="using:CultivoApp.Models"
             x:Class="CultivoApp.Views.CogumelosView"
             x:DataType="vm:CogumelosViewModel"
             x:Name="RootControl">

    <UserControl.Resources>
        <conv:ImagePathToBitmapConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" Spacing="20">

            <!-- 🔹 Título -->
            <TextBlock Text="🍄 Catálogo de Cogumelos"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"/>

            <!-- 🔹 Botões -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="Adicionar" 
                        Command="{Binding AddMushroomCommand}" 
                        Width="120" Background="#27AE60" Foreground="White"/>
                <Button Content="Salvar Alterações" 
                        Command="{Binding SaveChangesCommand}" 
                        Width="150" Background="#2980B9" Foreground="White"
                        IsVisible="{Binding IsEditing}"/>
            </StackPanel>

            <!-- 🔹 Lista de cogumelos -->
            <ItemsControl ItemsSource="{Binding Mushrooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:Mushroom">
                        <Border Background="White" Padding="15" CornerRadius="10" Margin="0,5"
                                BorderBrush="#DDD" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,5">

                                <!-- Imagem -->
                                <StackPanel Orientation="Vertical" Spacing="5">
                                    <Image Width="70" Height="70"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"/>

                                    <Button Content="🖼️ Imagem" 
                                            Command="{Binding #RootControl.DataContext.AdicionarImagemCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#8E44AD" Foreground="White" FontSize="12"
                                            HorizontalAlignment="Center"
                                            Padding="4,2" Width="80"/>
                                </StackPanel>

                                <!-- Informações (TEXTOS VISUAIS E PARÂMETROS NUMÉRICOS) -->
                                <StackPanel Grid.Column="1" Margin="10,0" Spacing="5">
                                    <TextBox Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                             BorderThickness="1" Background="White" Foreground="Black"
                                             Watermark="Nome do Cogumelo"
                                             IsReadOnly="{Binding #RootControl.DataContext.IsReadOnly}"/>
                                    
                                    <!-- Campos de Texto para o visor na Home -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBox Text="{Binding Temperature}" FontSize="14" Width="150"
                                                 BorderThickness="1" Background="White" Foreground="Black"
                                                 Watermark="Texto Ex. 18-25 °C"
                                                 IsReadOnly="{Binding #RootControl.DataContext.IsReadOnly}"/>
                                        
                                        <TextBox Text="{Binding Humidity}" FontSize="14" Width="150"
                                                 BorderThickness="1" Background="White" Foreground="Black"
                                                 Watermark="Texto Ex. 90-95%"
                                                 IsReadOnly="{Binding #RootControl.DataContext.IsReadOnly}"/>
                                    </StackPanel>

                                    <!-- NOVA PARTE: Limites Numéricos Reais (Para o ESP32) -->
                                    <StackPanel Orientation="Horizontal" Spacing="15" IsVisible="{Binding #RootControl.DataContext.IsEditing}" Margin="0,5,0,0">
                                        
                                        <!-- Bloco Temp Min/Max -->
                                        <StackPanel Orientation="Vertical" Spacing="2">
                                            <TextBlock Text="Limites de Temp (°C)" FontSize="11" Foreground="Gray" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <NumericUpDown Value="{Binding TempMin}" Minimum="0" Maximum="50" Increment="0.5" Width="100" Background="White" Foreground="Black" FormatString="F1"/>
                                                <TextBlock Text="até" VerticalAlignment="Center" Foreground="Gray"/>
                                                <NumericUpDown Value="{Binding TempMax}" Minimum="0" Maximum="50" Increment="0.5" Width="100" Background="White" Foreground="Black" FormatString="F1"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Bloco Umid Min/Max -->
                                        <StackPanel Orientation="Vertical" Spacing="2">
                                            <TextBlock Text="Limites de Umidade (%)" FontSize="11" Foreground="Gray" FontWeight="Bold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <NumericUpDown Value="{Binding UmidMin}" Minimum="0" Maximum="100" Increment="1" Width="100" Background="White" Foreground="Black" FormatString="F0"/>
                                                <TextBlock Text="até" VerticalAlignment="Center" Foreground="Gray"/>
                                                <NumericUpDown Value="{Binding UmidMax}" Minimum="0" Maximum="100" Increment="1" Width="100" Background="White" Foreground="Black" FormatString="F0"/>
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                    
                                </StackPanel>

                                <!-- Botões Editar e Excluir -->
                                <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="5">
                                    <Button Content="Editar"
                                            Command="{Binding #RootControl.DataContext.EditMushroomCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#F39C12" Foreground="White" Width="80"/>
                                    
                                    <Button Content="Excluir"
                                            Command="{Binding #RootControl.DataContext.DeleteMushroomCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#E74C3C" Foreground="White" Width="80"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>