<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:CultivoApp.ViewModels"
             x:Class="CultivoApp.Views.HistoricoView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel Spacing="15">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="📊" FontSize="22" Foreground="#000000"/>
                <TextBlock Text="Histórico de Temperatura e Umidade"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#000000"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="Janela de Tempo (Tempo Real):" 
                           VerticalAlignment="Center" 
                           Foreground="Black"
                           FontWeight="SemiBold"/>
                
                <Button Content="5 Minutos"
                        Command="{Binding MudarPeriodoCommand}"
                        CommandParameter="5M"
                        Background="#5BC0DE" Foreground="White"
                        FontWeight="SemiBold" CornerRadius="4"/>
                
                <Button Content="30 Minutos"
                        Command="{Binding MudarPeriodoCommand}"
                        CommandParameter="30M"
                        Background="#5BC0DE" Foreground="White"
                        FontWeight="SemiBold" CornerRadius="4"/>
                
                <Button Content="1 Hora"
                        Command="{Binding MudarPeriodoCommand}"
                        CommandParameter="1H"
                        Background="#5BC0DE" Foreground="White"
                        FontWeight="SemiBold" CornerRadius="4"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button Content="Exportar Histórico Completo"
                        Command="{Binding ExportarHistoricoCommand}"
                        Background="#107C41" Foreground="White"
                        FontWeight="SemiBold" CornerRadius="4"/>
                
                <Button Content="Resetar Dados"
                        Command="{Binding ResetarHistoricoCommand}"
                        Background="#D9534F" Foreground="White"
                        FontWeight="SemiBold" CornerRadius="4"/>
            </StackPanel>

            <Border Background="#FAFAFA" CornerRadius="10" Padding="15" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="🌡️ Temperatura (°C)"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#000000"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart Series="{Binding TemperaturaSeries}"
                                        XAxes="{Binding EixoX}"
                                        YAxes="{Binding EixoY}"
                                        Height="250"/>
                    <StackPanel Orientation="Horizontal" Spacing="25" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Border Background="#FFE0B2" CornerRadius="6" Padding="6,3">
                            <TextBlock Text="{Binding MediaTemperaturaTexto}" FontSize="14" Foreground="#000000"/>
                        </Border>
                        <Border Background="#FFE0B2" CornerRadius="6" Padding="6,3">
                            <TextBlock Text="{Binding DesvioTemperaturaTexto}" FontSize="14" Foreground="#000000"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FAFAFA" CornerRadius="10" Padding="15">
                <StackPanel>
                    <TextBlock Text="💧 Umidade (%)"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#000000"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart Series="{Binding UmidadeSeries}"
                                        XAxes="{Binding EixoX}"
                                        YAxes="{Binding EixoY}"
                                        Height="250"/>
                    <StackPanel Orientation="Horizontal" Spacing="25" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Border Background="#BBDEFB" CornerRadius="6" Padding="6,3">
                            <TextBlock Text="{Binding MediaUmidadeTexto}" FontSize="14" Foreground="#000000"/>
                        </Border>
                        <Border Background="#BBDEFB" CornerRadius="6" Padding="6,3">
                            <TextBlock Text="{Binding DesvioUmidadeTexto}" FontSize="14" Foreground="#000000"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>